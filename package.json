{
  "name": "roundwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:css": "node scripts/copy-fonts.mjs && tailwindcss -i src/web/app.css -o public/app.css --minify",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler d1 migrations apply roundwise --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply roundwise --local",
    "db:migrate:remote": "wrangler d1 migrations apply roundwise --remote",
    "backfill:local": "node scripts/backfill-local.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:client": "esbuild src/client/main.tsx --bundle --splitting --format=esm --minify --target=es2022 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outdir=public/js --chunk-names=chunks/[name]-[hash]",
    "build": "npm run build:css && npm run build:client"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.7.10",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.108.0"
  }
}
