{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roundwise",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    // Shown in the header and in the required "not endorsed" notice. Rename freely
    // (but not to anything containing "GRID" or "Riot Open Access" - ToS 9.4).
    "SITE_NAME": "Roundwise",
    // Earliest match date to import. Which tournaments are imported is set in src/ingest/scope.ts.
    "BACKFILL_FROM": "2026-01-01T00:00:00Z",
    // Series fetched from the Series State API per cron run (every minute), 8 at a time.
    // ~100 D1 rows are written per series. Sized for the Workers Paid plan (50M D1 rows written/month,
    // 1000 subrequests per run); on the free plan (100k rows/day, 50 subrequests) use 6.
    "BATCH_SIZE": "100",
    // Open Access data is delayed; don't ask for a series until this long after its scheduled start.
    "DELAY_HOURS": "4",
    // Rebuild leaderboard / map aggregates at most this often (they scan all stored maps).
    "AGG_EVERY_HOURS": "1"
  },

  // Builds public/app.css + public/js (UI SDK client) before dev/deploy and on changes under src/.
  "build": { "command": "npm run build", "watch_dir": "src" },

  // Static files (CSS, fonts, GRID logo for the required attribution).
  "assets": { "directory": "./public" },

  // Resizes team logos once at import (src/ingest/logos.ts).
  "images": { "binding": "IMAGES", "remote": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roundwise",
      "database_id": "496a538c-2599-42eb-b4ad-7088b5ebc2b8",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    // every minute: discover new series, ingest a batch, rebuild aggregates when stale
    "crons": ["* * * * *"]
  }
}
